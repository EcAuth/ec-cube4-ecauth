<script src="https://cdn.ec-auth.io/auth-js/{{ ecauth_auth_js_version }}/ecauth-auth.umd.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // 文言は JS 文字列に埋めるため e('js') でエスケープする。
    // Twig の自動エスケープは HTML 向けで、引用符が実体参照になるだけなので
    // JS リテラル内では正しく閉じられない値を作りうる。
    var BUTTON_LABEL = '{{ "ecauth_login43.admin.login.passkey_button"|trans|e('js') }}';
    var ERROR_MESSAGE = '{{ "ecauth_login43.admin.login.passkey.error"|trans|e('js') }}';
    var NOT_FOUND_MESSAGE = '{{ "ecauth_login43.admin.login.passkey.not_found"|trans|e('js') }}';
    // 初回利用者向けの常設案内。ログイン画面は EC-CUBE 本体のテンプレートなので、
    // 案内文の要素を差し込むと本体の変更に追従しづらい。ボタンの title
    // （ツールチップ）なら本体の DOM 構造に手を入れずに常時見せられる。
    var HINT_MESSAGE = '{{ "ecauth_login43.admin.login.passkey.hint"|trans|e('js') }}';
    var PASSWORD_DISABLED_MESSAGE = '{{ "ecauth_login43.admin.login.password_disabled.notice"|trans|e('js') }}';
    var PASSWORD_DISABLED_UNAVAILABLE_MESSAGE = '{{ "ecauth_login43.admin.login.password_disabled.notice_unavailable"|trans|e('js') }}';

    // 環境変数 ECAUTH_DISABLE_ADMIN_PASSWORD_LOGIN の状態（EcAuthLoginEvent が渡す）。
    // ここで行うのは入力欄を隠す案内だけで、実際に認証を拒否するのはサーバー側の
    // Security/AdminPasswordLoginListener。フォームを経由しない POST も塞ぐ必要があるため、
    // この JS を無効化しても守りは変わらない。
    var PASSWORD_LOGIN_DISABLED = {{ ecauth_password_login_disabled|default(false) ? 'true' : 'false' }};

    var loginForm = document.querySelector('form[action*="login"]');
    if (!loginForm) {
        return;
    }

    var submitButton = loginForm.querySelector('button[type="submit"]');

    // WebAuthn は HTTPS 必須。非対応ブラウザ・HTTP ではパスキーを提示できない。
    var passkeyAvailable = location.protocol === 'https:' && typeof window.PublicKeyCredential !== 'undefined';

    if (PASSWORD_LOGIN_DISABLED) {
        hidePasswordLogin(loginForm, submitButton);
        // パスキーも使えない環境では「押せるものが何も無い」画面になる。
        // 理由が分からないまま詰まらないよう、案内文を出し分ける。
        insertNotice(
            loginForm,
            submitButton,
            passkeyAvailable ? PASSWORD_DISABLED_MESSAGE : PASSWORD_DISABLED_UNAVAILABLE_MESSAGE
        );
    }

    if (!passkeyAvailable || !submitButton) {
        return;
    }

    // パスキーログインボタンを作成
    var passkeyBtn = document.createElement('button');
    passkeyBtn.type = 'button';
    passkeyBtn.id = 'ecauth-passkey-login';
    // パスワード認証が無効なときはこれが唯一のログイン手段になるので、
    // 本体の送信ボタンと同じ主ボタンの見た目にする。
    passkeyBtn.className = PASSWORD_LOGIN_DISABLED
        ? 'btn btn-primary btn-lg w-100'
        : 'btn btn-ec-regular btn-block mt-3';
    passkeyBtn.textContent = BUTTON_LABEL;
    passkeyBtn.title = HINT_MESSAGE;

    // ボタンを追加
    submitButton.parentNode.insertBefore(passkeyBtn, submitButton.nextSibling);

    // CSRF トークン取得（ecauth_passkey ID で生成）
    var csrfToken = '{{ csrf_token("ecauth_passkey") }}';

    passkeyBtn.addEventListener('click', function() {
        passkeyBtn.disabled = true;
        passkeyBtn.textContent = '認証中...';

        EcAuth.webauthn.authenticate({
            optionsUrl: '{{ url("ecauth_passkey_authenticate_options") }}',
            verifyUrl: '{{ url("ecauth_passkey_authenticate_verify") }}',
            csrfToken: csrfToken
        }).then(function(result) {
            if (result.redirect_url) {
                window.location.href = result.redirect_url;
            } else {
                passkeyBtn.disabled = false;
                passkeyBtn.textContent = BUTTON_LABEL;
                alert(ERROR_MESSAGE);
            }
        }).catch(function(error) {
            passkeyBtn.disabled = false;
            passkeyBtn.textContent = BUTTON_LABEL;
            // NotAllowedError はキャンセルだけでなく「該当するパスキーが端末に無い」
            // ときにも出る。ログイン画面は誰がログインするか未確定なので b2b_subject を
            // 送らず、EcAuth は組織内の全クレデンシャルを allowCredentials に詰めて返す。
            // そのためパスキー未登録の管理者が押すと、他人のパスキーだけが許可された
            // 状態で credentials.get() が呼ばれて必ずここへ来る。以前は握り潰していた
            // ため「押しても何も起きない」ように見えていた（#58）。
            if (error && error.name === 'NotAllowedError') {
                alert(NOT_FOUND_MESSAGE + '\n\n' + HINT_MESSAGE);

                return;
            }
            console.error('Passkey authentication error:', error);
            alert(ERROR_MESSAGE);
        });
    });

    /**
     * ID / パスワードの入力欄と送信ボタンを隠す。
     *
     * 入力欄そのものは DOM に残す（disabled にもしない）。隠したフォームが
     * それでも送信された場合に、サーバー側のリスナーが「パスワード認証は無効」と
     * 返せるようにしておくため。値を空にしてしまうと Symfony の
     * FormLoginAuthenticator が Passport を作る前に「Bad credentials」で落ち、
     * 理由が伝わらない。
     */
    function hidePasswordLogin(form, submit) {
        ['login_id', 'password'].forEach(function(name) {
            var input = form.querySelector('[name="' + name + '"]');
            if (!input) {
                return;
            }
            // 入力欄だけ消すと Bootstrap の余白が残るため、囲みの .mb-3 ごと隠す。
            // 本体のマークアップが変わって当たらない場合は親要素で代替する。
            var wrapper = (input.closest ? input.closest('.mb-3') : null) || input.parentNode || input;
            wrapper.classList.add('d-none');
        });

        if (submit) {
            submit.classList.add('d-none');
        }
    }

    /**
     * パスワード認証が無効である旨の案内を、ログインボタンの直前に差し込む。
     */
    function insertNotice(form, submit, message) {
        var notice = document.createElement('div');
        notice.id = 'ecauth-password-login-disabled';
        notice.className = 'alert alert-warning mb-3';
        notice.textContent = message;

        // 送信ボタンの囲み（= パスキーボタンが入る位置）の直前に置く。
        var anchor = submit ? submit.parentNode : null;
        if (anchor && anchor.parentNode) {
            anchor.parentNode.insertBefore(notice, anchor);

            return;
        }
        form.appendChild(notice);
    }
});
</script>
