{
  "name": "ec-cube/ecauthlogin40",
  "version": "1.1.0",
  "description": "EC-CUBE 4.0/4.1系向け EcAuth 認証プラグイン",
  "type": "eccube-plugin",
  "license": "LGPL-2.1-or-later",
  "extra": {
    "code": "EcAuthLogin40",
    "id": 0
  },
  "require": {
    "ec-cube/plugin-installer": "~0.0.6 || ^2.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "guzzlehttp/guzzle": "^6.3",
    "nyholm/psr7": "^1.8",
    "phpstan/phpstan": "^1.10",
    "phpunit/phpunit": "^9.6",
    "rector/rector": "^1.0",
    "symfony/cache": "^3.4 || ^4.4 || ^5.4"
  },
  "autoload-dev": {
    "psr-4": {
      "Plugin\\EcAuthLogin40\\": ""
    }
  },
  "scripts": {
    "phpunit": "phpunit --configuration phpunit.xml.dist"
  },
  "config": {
    "allow-plugins": {
      "ec-cube/plugin-installer": true
    }
  }
}
